---
import { CREDIBILITY } from "../lib/constants";
---

<section class="cred" aria-label="Organizations and tools">
  <div class="cred-band">
    <p class="band-label">Worked with</p>
    <div class="band-items">
      {CREDIBILITY.workedWith.map((org) => (
        <span class="wordmark">
          {org.name}
          {org.note && <span class="wordmark-note">({org.note})</span>}
        </span>
      ))}
      <span class="client-group">
        <span class="client-group-label">client work via Loop Tech:</span>
        {CREDIBILITY.loopTechClients.map((c) => (
          <span class="wordmark wordmark-client">{c}</span>
        ))}
      </span>
    </div>
  </div>

  <div class="cred-band">
    <p class="band-label">Built with</p>
    <div class="band-items marquee-viewport" data-marquee>
      <div class="marquee-track">
        {CREDIBILITY.builtWith.map((tool) => (
          <span class="wordmark wordmark-tool">{tool}</span>
        ))}
      </div>
      <div class="marquee-track" data-marquee-clone aria-hidden="true"></div>
    </div>
  </div>

  <div class="cred-band">
    <p class="band-label">Consulting projects at Ivey <span class="band-label-note">academic program work</span></p>
    <div class="band-items">
      {CREDIBILITY.iveyProjects.map((org) => (
        <span class="wordmark">{org}</span>
      ))}
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: the Built-with band becomes a marquee only when
  // JS runs and reduced motion is not requested. No-JS: plain wrapped row.
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const viewport = document.querySelector("[data-marquee]");
  const clone = document.querySelector("[data-marquee-clone]");
  if (!reduced && viewport instanceof HTMLElement && clone instanceof HTMLElement) {
    const track = viewport.querySelector(".marquee-track");
    if (track) {
      clone.innerHTML = track.innerHTML;
      viewport.classList.add("is-marquee");
    }
  }
</script>

<style>
  .cred {
    padding-block: var(--spacing-8) var(--spacing-12);
    display: grid;
    gap: var(--spacing-8);
  }

  .cred-band {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--spacing-6);
    align-items: baseline;
  }

  @media (max-width: 48rem) {
    .cred-band {
      grid-template-columns: 1fr;
      gap: var(--spacing-3);
    }
  }

  .band-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .band-label-note {
    display: block;
    margin-top: var(--spacing-1);
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--color-text-tertiary);
  }

  .band-items {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-8);
    row-gap: var(--spacing-3);
    align-items: baseline;
  }

  .wordmark {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .wordmark-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-tertiary);
    margin-left: var(--spacing-2);
  }

  .client-group {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-3);
    align-items: baseline;
    padding-left: var(--spacing-6);
    border-left: 2px solid var(--color-border-strong);
  }

  .client-group-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    flex-basis: 100%;
  }

  .wordmark-client {
    font-size: var(--text-base);
  }

  .wordmark-tool {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
  }

  /* Marquee enhancement (JS-armed only) */
  .marquee-viewport.is-marquee {
    flex-wrap: nowrap;
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .marquee-viewport.is-marquee .marquee-track {
    display: inline-flex;
    flex: none;
    column-gap: var(--spacing-8);
    padding-right: var(--spacing-8);
    animation: marquee-scroll 24s linear infinite;
  }

  .marquee-track {
    display: contents;
  }

  .marquee-viewport.is-marquee .marquee-track {
    display: inline-flex;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-viewport.is-marquee .marquee-track {
      animation: none;
    }
  }
</style>
