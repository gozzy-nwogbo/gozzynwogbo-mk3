---
// B1 visual seed of the "where does AI fit?" explorer. Static illustrative
// fragment only — no corpus data, no real interaction. B2 inherits this language.
---

<aside class="teaser enter" style="--enter-delay: 500ms" aria-label="Preview of the AI fit explorer">
  <p class="teaser-kicker">Interactive &middot; in progress</p>
  <p class="teaser-question">Where does AI fit in your org?</p>

  <div class="teaser-chips" aria-hidden="true">
    <span class="chip chip-active">Healthcare</span>
    <span class="chip">Logistics</span>
    <span class="chip">Finance</span>
    <span class="chip">Legal</span>
  </div>

  <div class="teaser-bars" aria-hidden="true">
    <div class="bar-row">
      <span class="bar-label">Document intake</span>
      <span class="bar-track"><span class="bar-fill" style="--bar: 86%"></span></span>
    </div>
    <div class="bar-row">
      <span class="bar-label">Client follow-up</span>
      <span class="bar-track"><span class="bar-fill" style="--bar: 64%"></span></span>
    </div>
    <div class="bar-row">
      <span class="bar-label">Reporting</span>
      <span class="bar-track"><span class="bar-fill" style="--bar: 48%"></span></span>
    </div>
  </div>

  <a href="#explorer" class="teaser-cta">Explore where AI fits <span aria-hidden="true">&darr;</span></a>
</aside>

<style>
  .teaser {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-md);
    padding: var(--spacing-8);
    max-width: 24rem;
  }

  .teaser-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-interactive);
    margin-bottom: var(--spacing-3);
  }

  .teaser-question {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .teaser-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: var(--spacing-6);
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    padding: 0.4375rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
  }

  .chip-active {
    background-color: var(--color-interactive);
    border-color: var(--color-interactive);
    color: var(--color-text-on-dark);
  }

  .teaser-bars {
    margin-top: var(--spacing-6);
    display: grid;
    gap: var(--spacing-4);
  }

  .bar-row {
    display: grid;
    gap: var(--spacing-2);
  }

  .bar-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .bar-track {
    display: block;
    height: 6px;
    border-radius: 999px;
    background-color: var(--color-interactive-subtle);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    width: var(--bar);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-interactive), var(--color-interactive-bright));
    transform-origin: left;
    animation: bar-grow 900ms var(--ease-out) both;
    animation-delay: 700ms;
  }

  @keyframes bar-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .teaser-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-top: var(--spacing-8);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-interactive);
  }

  .teaser-cta:hover {
    color: var(--color-interactive-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      animation: none;
      transform: none;
    }
  }
</style>
