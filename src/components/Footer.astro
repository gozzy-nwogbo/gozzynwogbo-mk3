---
import { PERSON, SOCIAL_LINKS } from "../lib/constants";

const year = new Date().getFullYear();
---

<footer class="footer bg-[var(--color-surface-invert)] text-[var(--color-text-on-dark)] mt-32">
  <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col sm:flex-row justify-between items-start gap-8">
    <div>
      <p class="footer-name">{PERSON.name}<span class="footer-dot" aria-hidden="true"></span></p>
      <p class="text-sm text-[var(--color-text-tertiary)] mt-1">{PERSON.jobTitle}</p>
      <p class="footer-credit">This site was built from my own knowledge corpus. Its structure was inspired by James Breedlove's portfolio, with thanks.</p>
    </div>
    <div class="flex gap-6">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--color-text-tertiary)] hover:text-[var(--color-text-on-dark)] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="text-sm text-[var(--color-text-tertiary)] hover:text-[var(--color-text-on-dark)] transition-colors"
      >
        Contact
      </a>
    </div>
  </div>
  <div class="border-t border-[var(--color-border-strong)]/20 max-w-5xl mx-auto px-6 py-4">
    <p class="text-xs text-[var(--color-text-tertiary)]">&copy; {year} {PERSON.name}</p>
  </div>
</footer>

<style>
  /* The far bank: footer opens on the bridge deck. */
  .footer {
    position: relative;
  }

  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-interactive));
  }

  .footer-name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 560;
    font-size: var(--text-lg);
  }

  .footer-dot {
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    border-radius: 999px;
    background-color: var(--color-accent);
    margin-left: 0.12em;
  }

  .footer-credit {
    margin-top: var(--spacing-4);
    max-width: 44ch;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    line-height: 1.7;
    color: var(--color-text-tertiary);
  }
</style>
