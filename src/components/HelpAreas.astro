---
// Four kinds of useful: the contact page's where-I-can-help grid as cards.
interface Area {
  label: string;
  line: string;
}

interface Props {
  areas: Area[];
}
const { areas } = Astro.props;
---

<div class="help-grid">
  {areas.map((area, i) => (
    <div class="help-item">
      <span class="help-num">{String(i + 1).padStart(2, "0")}</span>
      <h3 class="help-label">{area.label}</h3>
      <p class="help-line">{area.line}</p>
    </div>
  ))}
</div>

<style>
  .help-grid {
    margin-top: var(--spacing-10, 2.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-6);
  }

  @media (max-width: 40rem) {
    .help-grid {
      grid-template-columns: 1fr;
    }
  }

  .help-item {
    padding: var(--spacing-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .help-item:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .help-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .help-label {
    font-size: var(--text-xl);
    font-weight: 540;
    letter-spacing: -0.01em;
    margin-top: var(--spacing-3);
  }

  .help-line {
    margin-top: var(--spacing-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .help-item {
      transition: none;
    }
    .help-item:hover {
      transform: none;
    }
  }
</style>
