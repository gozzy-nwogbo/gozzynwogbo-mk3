---
import { PERSON } from "../lib/constants";
import Explorer from "./Explorer.astro";
import BridgeSpan from "./BridgeSpan.astro";
---

<section class="hero">
  <div class="hero-kicker enter" style="--enter-delay: 0ms">
    <hr class="bridge-rule kicker-rule" />
    <p class="kicker-text">
      <span class="kicker-name">{PERSON.name}</span>
      <span class="kicker-sep" aria-hidden="true">&middot;</span>
      {PERSON.jobTitle}
    </p>
  </div>

  <h1 class="hero-title">
    <span class="title-setup enter" style="--enter-delay: 100ms">Most AI never<br />leaves the demo.</span>
    <span class="title-payoff enter" style="--enter-delay: 220ms">I build the version that runs<span class="anchor-dot" aria-hidden="true"></span></span>
  </h1>

  <div class="hero-row">
    <div class="hero-main">
      <p class="hero-support enter" style="--enter-delay: 340ms">
        I come at it from business, not computer science, and that is what makes
        it useful. Based in Toronto.
      </p>

      <div class="hero-actions enter" style="--enter-delay: 440ms">
        <a href="/projects" class="btn btn-primary">See the work</a>
        <a href="/contact" class="btn btn-ghost">Let&rsquo;s talk <span class="btn-arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <div class="hero-side enter" style="--enter-delay: 520ms">
      <Explorer />
    </div>
  </div>

  <div class="hero-bridge enter" style="--enter-delay: 640ms">
    <BridgeSpan catenary traveler />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vh, 6rem) 0;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-10, 2.5rem);
  }

  .kicker-rule {
    width: 3rem;
    flex: none;
    margin: 0;
  }

  .kicker-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .kicker-name {
    position: relative;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  /* The name draws its own span: terracotta into teal, once, on load. */
  .kicker-name::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35em;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-interactive));
    transform-origin: left;
    animation: name-draw 700ms var(--ease-out) 1100ms both;
  }

  @keyframes name-draw {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .kicker-name::after {
      animation: none;
      transform: none;
    }
  }

  .kicker-sep {
    margin-inline: 0.5em;
    color: var(--color-text-tertiary);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(2.625rem, 6.4vw, 5.125rem);
    font-weight: 540;
    letter-spacing: -0.015em;
    line-height: 1.08;
    margin: 0;
  }

  .title-setup {
    display: block;
    color: var(--color-text-secondary);
  }

  .title-payoff {
    display: block;
    color: var(--color-text-primary);
  }

  /* Geometric bridge-anchor dot in place of the payoff period. */
  .anchor-dot {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    border-radius: 999px;
    background-color: var(--color-accent);
    margin-left: 0.08em;
  }

  .hero-row {
    margin-top: var(--spacing-12);
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr);
    gap: var(--spacing-16);
    align-items: center;
  }

  .hero-side {
    display: flex;
    justify-content: flex-end;
  }

  .hero-bridge {
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  @media (max-width: 56rem) {
    .hero-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-12);
    }
    .hero-side {
      justify-content: flex-start;
    }
  }

  .hero-support {
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .hero-actions {
    margin-top: var(--spacing-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-on-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn-ghost {
    border: 1px solid var(--color-interactive);
    color: var(--color-interactive);
  }

  .btn-ghost:hover {
    background-color: var(--color-interactive-subtle);
    color: var(--color-interactive-hover);
    border-color: var(--color-interactive-hover);
  }

  .btn-arrow {
    transition: transform var(--transition-fast);
  }

  .btn-ghost:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-arrow {
      transition: none;
    }
    .btn-primary:hover {
      transform: none;
    }
  }
</style>
