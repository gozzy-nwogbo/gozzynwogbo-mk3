---
// The walk-on: four sides of Gozzy crossing the hero background. Server HTML
// ships no video source; the runtime (src/scripts/walkon.ts) attaches sources
// only for desktop, light theme, motion allowed, data saver off.
import walkon from "../data/walkon.json";
---

<div
  class="walkon"
  data-walkon
  data-sources={JSON.stringify(walkon.sources)}
  data-walks={JSON.stringify(walkon.walks)}
>
  <div class="walkon-media" aria-hidden="true">
    <picture>
      <source srcset={walkon.posterAvif} type="image/avif" />
      <img class="walkon-poster" data-walkon-poster src={walkon.poster} alt="" decoding="async" />
    </picture>
    <video class="walkon-video" data-walkon-video muted loop playsinline preload="none"></video>
  </div>

  <ul class="walkon-labels">
    {walkon.walks.map((w) => <li><span class="walkon-label" data-walkon-label>{w.label}</span></li>)}
  </ul>

  <button type="button" class="walkon-toggle" data-walkon-toggle aria-label="Pause background video" hidden>
    <span class="walkon-toggle-icon" aria-hidden="true"></span>
  </button>
</div>

<script>
  import { initWalkOn } from "../scripts/walkon";
  initWalkOn();
</script>

<style>
  /* Stage box: a 16:9 window right of the copy. The footage holds his face
     near (50%, 20%) of the frame, which lands it right of the subtitle. */
  .walkon {
    --walkon-opacity: 0.46;
    --walkon-shift-x: 0%;
    /* Stage box anchored to the 61rem content column: from 57% across it to
       past its right edge, from the headline's top down into the demo card. */
    --stage-left: calc((100vw - 61rem) / 2 + 28.75rem);
    --stage-top: 7.25rem;
    --stage-w: 40.75rem;
    --stage-h: 32.75rem;
    /* Zoom about the hold-frame face so the crop lands near the elbows. */
    --walkon-zoom: 1.35;
    position: absolute;
    top: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    height: 100svh;
    pointer-events: none;
    overflow: clip;
    /* Where his face lands during the hold (footage mark 0.49, 0.29). */
    --face-x: calc(var(--stage-left) + var(--stage-w) * 0.5);
  }

  /* Only the footage and labels sit behind the copy; the toggle stays
     above it so it can be clicked. */
  .walkon-media,
  .walkon-labels {
    z-index: -1;
  }

  .walkon-media {
    position: absolute;
    left: var(--stage-left);
    top: var(--stage-top);
    width: var(--stage-w);
    height: var(--stage-h);
    overflow: hidden;
    opacity: var(--walkon-opacity);
    /* Radial feather, intersected with a left-edge fade: he walks in out of the wings, and
       nothing of him sits under the subtitle (WCAG contrast, tests/e2e/contrast.spec.ts). */
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 45%, #000 55%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 44%);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(ellipse 50% 50% at 50% 45%, #000 55%, transparent 100%),
      linear-gradient(90deg, transparent 0%, #000 44%);
    mask-composite: intersect;
  }

  /* Cream scrim under the headline column: text contrast never depends on
     what the footage shows. */
  .walkon-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--color-surface) 0%, transparent 18%);
  }

  .walkon-poster,
  .walkon-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 51% center;
    transform: translateX(var(--walkon-shift-x)) scale(var(--walkon-zoom));
    transform-origin: 51% 29%;
  }

  .walkon-video {
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .walkon.is-playing .walkon-video {
    opacity: 1;
  }

  .walkon-labels {
    position: absolute;
    left: var(--face-x);
    /* Just above his head: face centre 0.287 of the frame, face height 0.247, scaled by the zoom. */
    top: calc(var(--stage-top) + var(--stage-h) * (0.287 - 0.247 * var(--walkon-zoom) * 0.62) - 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .walkon-labels li {
    position: absolute;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .walkon-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .walkon-label.is-active {
    opacity: 1;
  }

  .walkon-toggle {
    position: absolute;
    z-index: 1;
    left: calc(var(--face-x) + 4.5rem);
    top: calc(var(--stage-top) + var(--stage-h) * (0.287 - 0.247 * var(--walkon-zoom) * 0.62) - 2.5rem);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text-primary);
    pointer-events: auto;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .walkon-toggle[hidden] {
    display: none;
  }

  .walkon-toggle:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 3px;
  }

  /* Pause glyph: two bars; play glyph when paused. */
  .walkon-toggle-icon {
    width: 0.6rem;
    height: 0.7rem;
    border-inline: 0.18rem solid currentColor;
  }

  .walkon-toggle[aria-label="Play background video"] .walkon-toggle-icon {
    border: 0;
    width: 0;
    height: 0;
    border-block: 0.38rem solid transparent;
    border-left: 0.6rem solid currentColor;
  }

  :global(html[data-theme="dark"]) .walkon {
    display: none;
  }

  @media (max-width: 56rem) {
    .walkon {
      display: none;
    }
  }
</style>
