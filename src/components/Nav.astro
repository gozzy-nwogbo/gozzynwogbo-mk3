---
import { NAV_LINKS, PERSON } from "../lib/constants";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<nav aria-label="Main navigation" class="flex items-center justify-between gap-4 px-6 py-5 max-w-5xl mx-auto">
  <a href="/" class="brand whitespace-nowrap text-lg text-[var(--color-text-primary)]">
    {PERSON.givenName} {PERSON.familyName}<span class="brand-dot" aria-hidden="true"></span>
  </a>
  <div class="flex items-center gap-4 sm:gap-6">
    <ul class="hidden sm:flex gap-5 sm:gap-6 list-none m-0 p-0">
      {NAV_LINKS.filter(link => link.href !== "/").map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "nav-link text-sm font-medium transition-colors",
              isActive(link.href)
                ? "is-active text-[var(--color-text-primary)]"
                : "text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" hidden>
      <span class="tt-dot" aria-hidden="true"></span>
    </button>
    <details class="mnav sm:hidden">
      <summary class="mnav-btn" aria-label="Menu">
        <span class="mnav-bar" aria-hidden="true"></span>
        <span class="mnav-bar" aria-hidden="true"></span>
      </summary>
      <ul class="mnav-panel list-none m-0">
        {NAV_LINKS.filter(link => link.href !== "/").map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "mnav-link",
                isActive(link.href) && "is-active",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</nav>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (btn) {
    const label = () =>
      btn.setAttribute(
        "aria-label",
        document.documentElement.dataset.theme === "dark"
          ? "Switch to light theme"
          : "Switch to dark theme",
      );
    btn.hidden = false;
    label();
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      label();
    });
  }
</script>

<style>
  .brand {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--color-text-primary);
  }

  .brand-dot {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    border-radius: 999px;
    background-color: var(--color-accent);
    margin-left: 0.14em;
    transform: translateY(-0.02em);
    transition: background-color var(--transition-fast);
  }

  .brand:hover .brand-dot {
    background-color: var(--color-interactive);
  }

  .nav-link {
    position: relative;
    padding-bottom: 0.375rem;
  }

  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-interactive));
  }

  /* Theme toggle: the other bank. Dot shows the theme you would cross to. */
  .theme-toggle {
    width: 2rem;
    height: 2rem;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .theme-toggle:hover {
    border-color: var(--color-interactive);
  }

  .tt-dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background-color: var(--color-text-primary);
    transition: background-color var(--transition-fast);
  }

  /* Mobile disclosure menu — works with no JS via <details>. */
  .mnav {
    position: relative;
  }

  .mnav-btn {
    list-style: none;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    cursor: pointer;
  }

  .mnav-btn::-webkit-details-marker {
    display: none;
  }

  .mnav-bar {
    display: block;
    height: 1.5px;
    border-radius: 999px;
    background-color: var(--color-text-primary);
    transition: transform var(--transition-fast);
  }

  .mnav[open] .mnav-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mnav[open] .mnav-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mnav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 11rem;
    padding: var(--spacing-2);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    z-index: 50;
  }

  .mnav-link {
    display: block;
    padding: 0.75rem var(--spacing-4);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .mnav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface-subtle);
  }

  .mnav-link.is-active {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .tt-dot,
    .mnav-bar {
      transition: none;
    }
  }
</style>
