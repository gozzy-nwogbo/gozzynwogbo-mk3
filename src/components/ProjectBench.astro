---
import ProjectCard from "./ProjectCard.astro";
import SpanHeader from "./SpanHeader.astro";
import { PROJECT_CARD_IMAGES } from "../lib/constants";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;
const [flagship, ...rest] = projects;
---

<section class="bench">
  <SpanHeader index="04" label="Selected work">
    Work that <em>runs</em>.
  </SpanHeader>

  {flagship && (
    <a href={`/projects/${flagship.id}/`} class="feature">
      <div class="feature-text">
        <span class="feature-meta">{flagship.data.domain} &middot; {flagship.data.status} &middot; the flagship</span>
        {flagship.data.philosophy && <p class="feature-philosophy">{flagship.data.philosophy}</p>}
        <h3 class="feature-title">{flagship.data.title}</h3>
        <p class="feature-desc">{flagship.data.description}</p>
        <span class="feature-link">Read the case study <span aria-hidden="true">&rarr;</span></span>
      </div>
      <figure class="feature-visual feature-photo">
        <img
          src="/projects/atomos-motif.jpg"
          alt="Generated print-style motif of a knowledge graph: linked terracotta nodes across a cream page"
          loading="lazy"
          width="1600"
          height="1200"
        />
        <figcaption class="feature-photo-cap">Knowledge-graph motif &middot; generated in-house</figcaption>
      </figure>
    </a>
  )}

  <div class="bench-head">
    <p class="bench-note">And the rest of the bench, each ending in an outcome.</p>
    <div class="bench-controls" data-bench-controls hidden>
      <button type="button" class="bench-btn" data-bench-prev aria-label="Previous projects">&larr;</button>
      <button type="button" class="bench-btn" data-bench-next aria-label="Next projects">&rarr;</button>
    </div>
  </div>

  <div class="bench-track" data-bench-track>
    {rest.map((project) => (
      <div class="bench-item">
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          domain={project.data.domain}
          status={project.data.status}
          philosophy={project.data.philosophy}
          metric={{ value: project.data.metrics[0].value, label: project.data.metrics[0].label }}
          technologies={project.data.technologies.slice(0, 4)}
          image={PROJECT_CARD_IMAGES[project.id]}
        />
      </div>
    ))}
  </div>

  <p class="bench-more">
    <a href="/projects/">View all projects &rarr;</a>
  </p>
</section>

<script>
  // Progressive enhancement: arrow controls for the scroll-snap track.
  // Without JS the track is a native horizontal scroller — every card reachable.
  const track = document.querySelector<HTMLElement>("[data-bench-track]");
  const controls = document.querySelector<HTMLElement>("[data-bench-controls]");
  if (track && controls) {
    controls.hidden = false;
    const step = () => {
      const item = track.querySelector<HTMLElement>(".bench-item");
      return item ? item.offsetWidth + 24 : 360;
    };
    controls.querySelector("[data-bench-prev]")?.addEventListener("click", () => {
      track.scrollBy({ left: -step(), behavior: "smooth" });
    });
    controls.querySelector("[data-bench-next]")?.addEventListener("click", () => {
      track.scrollBy({ left: step(), behavior: "smooth" });
    });
  }
</script>

<style>
  .bench {
    padding-block: var(--spacing-16);
  }

  /* Flagship feature plate */
  .feature {
    margin-top: var(--spacing-8);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    color: var(--color-text-primary);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .feature:hover {
    color: var(--color-text-primary);
    border-color: var(--color-interactive);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  @media (max-width: 56rem) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature :global(.feature-visual) {
      order: -1;
      min-height: 11rem;
    }
  }

  .feature-text {
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .feature :global(.feature-visual) {
    border-radius: 0;
    min-height: 100%;
  }

  .feature-photo {
    margin: 0;
    position: relative;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .feature-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-slow);
  }

  .feature:hover .feature-photo img {
    transform: scale(1.03);
  }

  .feature-photo-cap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-3) var(--spacing-4);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: linear-gradient(180deg, transparent, var(--color-surface-subtle));
  }

  .feature-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .feature-philosophy {
    margin-top: var(--spacing-5, 1.25rem);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.35;
    color: var(--color-text-primary);
    border-left: 2px solid var(--color-accent);
    padding-left: var(--spacing-5, 1.25rem);
    max-width: 30ch;
  }

  .feature-title {
    margin-top: var(--spacing-6);
    font-size: var(--text-2xl);
    font-weight: 540;
    letter-spacing: -0.01em;
    transition: color var(--transition-fast);
  }

  .feature:hover .feature-title {
    color: var(--color-interactive);
  }

  .feature-desc {
    margin-top: var(--spacing-3);
    max-width: 52ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .feature-link {
    display: inline-block;
    margin-top: var(--spacing-6);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-interactive);
  }

  .bench-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-6);
    margin-block: var(--spacing-6) var(--spacing-8);
  }

  .bench-note {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  .bench-controls {
    display: flex;
    gap: var(--spacing-2);
  }

  .bench-btn {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-strong);
    background: none;
    color: var(--color-text-primary);
    font-size: var(--text-lg);
    cursor: pointer;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .bench-btn:hover {
    border-color: var(--color-interactive);
    color: var(--color-interactive);
  }

  .bench-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(19rem, 24rem);
    gap: var(--spacing-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--spacing-4);
    scrollbar-width: thin;
  }

  @media (max-width: 30rem) {
    .bench-track {
      grid-auto-columns: 86%;
    }
  }

  .bench-item {
    scroll-snap-align: start;
    display: grid;
  }

  .bench-more {
    margin-top: var(--spacing-6);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-photo img {
      transition: none;
    }
    .feature:hover .feature-photo img {
      transform: none;
    }
  }
</style>
