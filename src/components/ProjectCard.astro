---
interface Props {
  slug: string;
  title: string;
  description: string;
  domain: string;
  metric: { value: string; label: string };
  technologies: string[];
}

const { slug, title, description, domain, metric, technologies } = Astro.props;
---

<a href={`/projects/${slug}`} class="block p-6 border border-[var(--color-border)] rounded-[var(--radius-md)] hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)] transition-all group">
  <span class="text-xs font-medium text-[var(--color-text-tertiary)] uppercase tracking-wide">
    {domain}
  </span>
  <h2 class="text-xl font-semibold mt-2 mb-2 group-hover:text-[var(--color-accent)] transition-colors">
    {title}
  </h2>
  <p class="text-sm text-[var(--color-text-secondary)] mb-4">{description}</p>
  <p class="text-2xl font-bold" style="color: var(--color-accent);">{metric.value}</p>
  <p class="text-xs text-[var(--color-text-tertiary)] mt-0.5">{metric.label}</p>
  <div class="flex flex-wrap gap-1.5 mt-4">
    {technologies.map((tech) => (
      <span class="text-xs text-[var(--color-text-tertiary)] px-1.5 py-0.5 border border-[var(--color-border)] rounded-sm">
        {tech}
      </span>
    ))}
  </div>
</a>
