---
interface Props {
  slug: string;
  title: string;
  description: string;
  domain: string;
  metric: { value: string; label: string };
  technologies: string[];
}

const { slug, title, description, domain, metric, technologies } = Astro.props;
---

<a href={`/projects/${slug}`} class="card group">
  <span class="card-domain">{domain}</span>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <div class="card-metric">
    <p class="card-metric-value">{metric.value}</p>
    <p class="card-metric-label">{metric.label}</p>
  </div>
  <div class="card-tech">
    {technologies.map((tech) => (
      <span class="card-chip">{tech}</span>
    ))}
  </div>
  <span class="card-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--spacing-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .card:hover {
    color: var(--color-text-primary);
    border-color: var(--color-interactive);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-domain {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .card-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: var(--spacing-3);
    margin-bottom: var(--spacing-2);
    transition: color var(--transition-fast);
  }

  .card:hover .card-title {
    color: var(--color-interactive);
  }

  .card-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-6);
  }

  .card-metric {
    margin-top: auto;
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border);
  }

  .card-metric-value {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .card-metric-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--spacing-1);
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: var(--spacing-4);
  }

  .card-chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
    padding: 0.3125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-tertiary);
  }

  .card-arrow {
    position: absolute;
    top: var(--spacing-8);
    right: var(--spacing-8);
    color: var(--color-text-tertiary);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-interactive);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-arrow {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
