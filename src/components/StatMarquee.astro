---
// Editorial stat strip: Fraunces numbers, mono labels, diamond separators,
// one italic phrase. Marquee only when JS arms it; static wrapped row otherwise.
interface Props {
  stats: { value: string; label: string }[];
  phrase?: string;
}
const { stats, phrase } = Astro.props;
---

<div class="statm" data-statm>
  <div class="statm-track">
    {stats.map((stat) => (
      <span class="statm-item">
        <span class="statm-num">{stat.value}</span>
        <span class="statm-label">{stat.label}</span>
        <span class="statm-sep" aria-hidden="true">&#9670;</span>
      </span>
    ))}
    {phrase && (
      <span class="statm-item">
        <span class="statm-phrase">{phrase}</span>
        <span class="statm-sep" aria-hidden="true">&#9670;</span>
      </span>
    )}
  </div>
  <div class="statm-track" data-statm-clone aria-hidden="true"></div>
</div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const viewport = document.querySelector("[data-statm]");
  const clone = document.querySelector("[data-statm-clone]");
  if (!reduced && viewport instanceof HTMLElement && clone instanceof HTMLElement) {
    const track = viewport.querySelector(".statm-track");
    if (track) {
      clone.innerHTML = track.innerHTML;
      viewport.classList.add("is-marquee");
    }
  }
</script>

<style>
  .statm {
    padding-block: var(--spacing-8);
  }

  .statm-track {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--spacing-6);
    row-gap: var(--spacing-6);
  }

  .statm-item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-4);
    white-space: nowrap;
  }

  .statm-num {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(2.5rem, 4.5vw, 3.75rem);
    font-weight: 540;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .statm-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    max-width: 24ch;
    white-space: normal;
    line-height: 1.5;
  }

  .statm-phrase {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 460;
    color: var(--color-text-secondary);
  }

  .statm-sep {
    color: var(--color-accent);
    font-size: var(--text-xs);
    margin-left: var(--spacing-2);
  }

  /* Marquee enhancement */
  .statm.is-marquee {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 6%, black 94%, transparent);
  }

  .statm.is-marquee .statm-track {
    flex: none;
    flex-wrap: nowrap;
    column-gap: var(--spacing-6);
    padding-right: var(--spacing-6);
    animation: statm-scroll 36s linear infinite;
  }

  .statm.is-marquee .statm-label {
    white-space: nowrap;
    max-width: none;
  }

  @keyframes statm-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .statm.is-marquee .statm-track {
      animation: none;
    }
  }
</style>
