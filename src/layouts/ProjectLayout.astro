---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MetricsTable from "../components/MetricsTable.astro";
import AISummary from "../components/AISummary.astro";

interface Props {
  title: string;
  description: string;
  domain: string;
  technologies: string[];
  datePublished: Date;
  metrics: { label: string; value: string; benchmark?: string }[];
  ogImage?: string;
  schemaJsonLd?: Record<string, unknown>[];
}

const { title, description, domain, technologies, datePublished, metrics, ogImage, schemaJsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} schemaJsonLd={schemaJsonLd}>
  <Breadcrumbs items={[{ label: "Projects", href: "/projects" }, { label: title, href: "#" }]} />
  <article class="max-w-[65ch] mx-auto">
    <header class="mb-12">
      <h1 class="mb-3">{title}</h1>
      <div class="flex flex-wrap gap-3 items-center text-sm text-[var(--color-text-secondary)]">
        <span class="px-2 py-0.5 bg-[var(--color-accent-subtle)] text-[var(--color-accent)] rounded-sm font-medium">
          {domain}
        </span>
        <time datetime={datePublished.toISOString().split("T")[0]}>
          {datePublished.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
        </time>
      </div>
      <div class="flex flex-wrap gap-2 mt-3">
        {technologies.map((tech) => (
          <span class="text-xs text-[var(--color-text-tertiary)] px-2 py-0.5 border border-[var(--color-border)] rounded-sm">
            {tech}
          </span>
        ))}
      </div>
    </header>

    <slot />

    {metrics.length > 0 && (
      <section class="mt-16">
        <h2>Key Metrics</h2>
        <MetricsTable metrics={metrics} />
      </section>
    )}
  </article>
</BaseLayout>
