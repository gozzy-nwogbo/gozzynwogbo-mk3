---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AISummary from "../components/AISummary.astro";
import SkillGrid from "../components/SkillGrid.astro";
import FAQSection from "../components/FAQSection.astro";
import SpanHeader from "../components/SpanHeader.astro";
import BridgeProgressRail from "../components/BridgeProgressRail.astro";
import Reveal from "../components/Reveal.astro";
import { PERSON } from "../lib/constants";
import { generatePersonSchema } from "../schemas/person";
import { generateProfilePageSchema } from "../schemas/profilePage";

const railItems = [
  { id: "background", index: "01", label: "Background" },
  { id: "expertise", index: "02", label: "Expertise" },
  { id: "how-i-work", index: "03", label: "How I work" },
  { id: "faq", index: "04", label: "FAQ" },
];

const skills = [
  {
    category: "Business judgment",
    items: [
      "Business model analysis",
      "Investment screening and diligence",
      "Tender and bid strategy",
      "AI transformation strategy",
      "Market and competitive analysis",
    ],
  },
  {
    category: "AI systems & agents",
    items: [
      "AI systems design",
      "Agent design and orchestration",
      "MCP servers and tooling",
      "Retrieval and knowledge systems",
      "LangChain",
      "PostgreSQL / pgvector",
    ],
  },
  {
    category: "Automation & delivery",
    items: [
      "n8n workflow automation",
      "Python",
      "Cron agents and pipelines",
      "Supabase",
      "Astro",
    ],
  },
];

const faq = [
  {
    question: "So what do you do?",
    answer:
      "I build AI systems that give organizations leverage they do not have yet. In practice, I take frontier AI tools and turn them into things that run inside a business: knowledge systems, automations, agents. Two years hands-on, business background underneath it.",
  },
  {
    question: "Why AI? How did you get into it?",
    answer:
      "I came at it from business, not computer science. About two years ago these tools crossed the line from toys to real amplifiers, and I went deep, built on the frontier instead of waiting for it to mature. The business lens is what makes it useful. I am not building tech for its own sake, I am building leverage.",
  },
  {
    question: "Are you a student, or further along than that?",
    answer:
      "I am early, and I treat that as an edge. No habits to unlearn, and I have been living on the frontier of these tools while they are still new to most professionals. I have already shipped real work for real organizations. I would rather be judged on what I have built than years served.",
  },
  {
    question: "Why you? What makes you different?",
    answer:
      "Two things rarely sit in one person: a business head and frontier-AI hands. I have both. I build systems that outlast me, not dependencies on me. And I bring the standard to places it has not reached yet.",
  },
];

const schemas = [generateProfilePageSchema(), generatePersonSchema()];
---

<BaseLayout
  title="About"
  description={`${PERSON.name} builds AI systems that run inside real businesses: knowledge engines, automations, and agents. Business background, two years on the frontier. Based in Toronto.`}
  schemaJsonLd={schemas}
  markdownUrl="/about.md"
>
  <Breadcrumbs items={[{ label: "About", href: "/about" }]} />
  <BridgeProgressRail items={railItems} />

  <h1 class="about-title">About<span class="about-dot" aria-hidden="true"></span></h1>

  <AISummary>
    <p>
      Gozzy Nwogbo is an AI systems builder based in Toronto, Canada. He holds an MSc in Digital
      Management from Ivey Business School and a BSc in Business Administration from Boston
      University, concentrating in Management Strategy and Management Information Systems.
      He builds AI systems that give organizations leverage they do not have yet: knowledge systems,
      automations, and agents made to run inside a real business. His work spans a personal knowledge
      OS holding 70+ domains, an automated ad pipeline shipped end to end, a bid and investment
      screening engine for a six-country infrastructure group, and a catalog of 483 automation
      workflows. He came at AI from business, and the business lens is what makes his systems useful.
    </p>
  </AISummary>

  <section class="about-section" id="background">
    <SpanHeader index="01" label="Background">
      The <em>bridge</em>, built from the business side.
    </SpanHeader>
    <div class="bg-grid">
      <div class="bg-text">
        <p class="mt-4 leading-relaxed">
          I came at AI from business, not computer science. Business school taught me how to take a
          messy organization apart on paper: what it sells, where the margin lives, which problems are
          worth solving and for whom. That training runs underneath everything I build.
        </p>
        <p class="mt-4 leading-relaxed">
          About two years ago, AI tools crossed a line. They stopped being toys and became amplifiers,
          and I made a decision: go deep now, build on the frontier while it is still forming, instead
          of waiting for it to mature into something safe. Since then I have built daily. Knowledge
          systems, agents, automation pipelines, real deliverables for real organizations.
        </p>
        <p class="mt-4 leading-relaxed">
          The result is a bridge. Two things rarely sit in one person: a business head and frontier-AI
          hands. I have both. I sit between what AI can do and how organizations actually work, and I
          close that gap myself rather than handing off a requirements document and hoping.
        </p>
      </div>
      <Reveal class="bg-photo-wrap">
        <figure class="bg-photo">
          <img
            src="/headshot.jpg"
            alt={`${PERSON.name}, AI systems builder, Toronto`}
            width="1600"
            height="1066"
            loading="eager"
          />
        </figure>
      </Reveal>
    </div>
  </section>

  <section class="about-section" id="expertise">
    <SpanHeader index="02" label="Expertise">
      Business judgment, systems, <em>delivery</em>.
    </SpanHeader>
    <SkillGrid skills={skills} />
  </section>

  <section class="about-section" id="how-i-work">
    <SpanHeader index="03" label="How I work">
      Business first, then <em>build to prove</em>.
    </SpanHeader>
    <p class="mt-4 leading-relaxed">
      Business first. Before any system gets built, I want to know what it is worth: whose time it
      saves, what that time costs, what changes if it works. I measure in time saved first, then
      convert to money. Technology that cannot answer those questions is a hobby, and I keep my
      hobbies separate.
    </p>
    <p class="mt-4 leading-relaxed">
      Then I build to prove. I do not sell outcomes I have not produced. Every system starts with a
      spec that defines what done looks like before a line of code is written, and the fastest way
      to settle whether something will work is a small pilot you can see with your own eyes before
      you commit to anything. The systems I rely on daily were built the same way, which is why I
      can show them instead of describing them.
    </p>
  </section>

  <section class="about-section" id="faq">
    <SpanHeader index="04" label="FAQ">
      The questions I <em>actually</em> get.
    </SpanHeader>
    <FAQSection items={faq} hideTitle />
  </section>
</BaseLayout>

<style>
  .about-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 520;
    letter-spacing: -0.015em;
    margin: var(--spacing-8) 0 var(--spacing-12);
  }

  .about-dot {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    border-radius: 999px;
    background-color: var(--color-accent);
    margin-left: 0.08em;
  }

  .about-section {
    margin-bottom: var(--spacing-24);
    scroll-margin-top: var(--spacing-16);
  }

  .bg-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--spacing-16);
    align-items: start;
    margin-top: var(--spacing-8);
  }

  .bg-text {
    max-width: 58ch;
  }

  @media (max-width: 56rem) {
    .bg-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-8);
    }
  }

  .bg-photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .bg-photo img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
