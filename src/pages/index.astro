---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImpactStats from "../components/ImpactStats.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE, PERSON } from "../lib/constants";
import { generatePersonSchema } from "../schemas/person";
import { generateWebSiteSchema } from "../schemas/website";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const stats = [
  { number: "3", label: "technology ventures in active development" },
  { number: "35%", label: "workflow efficiency gain in healthcare pilot" },
  { number: "10,000+", label: "monthly transactions on fintech platform" },
];

const schemas = [generateWebSiteSchema(), generatePersonSchema()];
---

<BaseLayout title={SITE.name} description={SITE.description} schemaJsonLd={schemas}>
  <!-- Hero -->
  <section class="py-24">
    <h1 class="text-5xl font-bold">{PERSON.name}</h1>
    <p class="text-xl text-[var(--color-text-secondary)] mt-3">{PERSON.jobTitle}</p>
    <p class="text-lg text-[var(--color-text-secondary)] mt-4 max-w-[55ch] leading-relaxed">
      Building consulting capabilities at Deloitte while developing fintech,
      healthcare, and defense technology platforms for Nigeria's emerging
      tech ecosystem. Based in Toronto.
    </p>
    <ImpactStats stats={stats} />
  </section>

  <!-- Featured Projects -->
  <section class="py-16">
    <h2 class="text-3xl font-semibold mb-8">Projects</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          domain={project.data.domain}
          metric={{ value: project.data.metrics[0].value, label: project.data.metrics[0].label }}
          technologies={project.data.technologies.slice(0, 4)}
        />
      ))}
    </div>
    <p class="mt-6">
      <a href="/projects" class="text-sm font-medium">View all projects &rarr;</a>
    </p>
  </section>

  <!-- About Preview -->
  <section class="py-16">
    <h2 class="text-3xl font-semibold mb-4">About</h2>
    <p class="text-[var(--color-text-secondary)] max-w-[55ch] leading-relaxed">
      I sit at the intersection of management consulting and platform engineering.
      My consulting training gives me the frameworks to analyze markets and structure
      decisions. My engineering work gives me the ability to build what the analysis reveals.
      The Nigerian market is where these two tracks converge.
    </p>
    <p class="mt-4">
      <a href="/about" class="text-sm font-medium">Read more &rarr;</a>
    </p>
  </section>
</BaseLayout>
