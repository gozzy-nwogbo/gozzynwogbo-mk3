---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MovingBanner from "../components/MovingBanner.astro";
import AboutSection from "../components/AboutSection.astro";
import Experience from "../components/Experience.astro";
import ProofCharge from "../components/ProofCharge.astro";
import ProjectBench from "../components/ProjectBench.astro";
import CompetencyGrid from "../components/CompetencyGrid.astro";
import ContactSection from "../components/ContactSection.astro";
import SpanHeader from "../components/SpanHeader.astro";
import BridgeProgressRail from "../components/BridgeProgressRail.astro";
import { SITE } from "../lib/constants";
import { generatePersonSchema } from "../schemas/person";
import { generateWebSiteSchema } from "../schemas/website";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const railItems = [
  { id: "about", index: "01", label: "About" },
  { id: "experience", index: "02", label: "Experience" },
  { id: "proof", index: "03", label: "By the work" },
  { id: "work", index: "04", label: "Selected work" },
  { id: "bring", index: "05", label: "What I bring" },
  { id: "contact", index: "06", label: "Contact" },
];

const schemas = [generateWebSiteSchema(), generatePersonSchema()];
---

<BaseLayout title={SITE.name} description={SITE.description} schemaJsonLd={schemas}>
  <BridgeProgressRail items={railItems} />

  <!-- Hero -->
  <Hero />

  <!-- What's moving: unnumbered, hangs straight off the hero's bridge deck -->
  <MovingBanner />

  <!-- 01 · About -->
  <section class="pt-8 pb-12 scroll-mt-16" id="about">
    <AboutSection />
  </section>

  <!-- 02 · Experience -->
  <section class="pt-8 pb-12 scroll-mt-16" id="experience">
    <SpanHeader index="02" label="Experience">
      Laying the foundation of a <em>hybrid</em> practice.
    </SpanHeader>
    <Experience />
  </section>

  <!-- 03 · Selected proof -->
  <section class="pt-8 pb-12 scroll-mt-16" id="proof">
    <ProofCharge />
  </section>

  <!-- 04 · Featured projects -->
  <div id="work" class="scroll-mt-16">
    <ProjectBench projects={projects} />
  </div>

  <!-- 05 · What I bring -->
  <div id="bring" class="scroll-mt-16">
    <CompetencyGrid />
  </div>

  <!-- 06 · Contact & availability -->
  <section id="contact" class="scroll-mt-16">
    <ContactSection />
  </section>
</BaseLayout>
