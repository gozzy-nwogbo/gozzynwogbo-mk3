---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CredibilityStrip from "../components/CredibilityStrip.astro";
import StatCounter from "../components/StatCounter.astro";
import ProjectBench from "../components/ProjectBench.astro";
import CompetencyGrid from "../components/CompetencyGrid.astro";
import { SITE, PERSON } from "../lib/constants";
import { generatePersonSchema } from "../schemas/person";
import { generateWebSiteSchema } from "../schemas/website";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const stats = [
  { value: "70+", label: "knowledge domains running on a system I built and use daily" },
  { value: "483", label: "automation workflows across 8 domains" },
  { value: "3 days", label: "to produce a full priced tender package a team scopes in weeks" },
];

const schemas = [generateWebSiteSchema(), generatePersonSchema()];
---

<BaseLayout title={SITE.name} description={SITE.description} schemaJsonLd={schemas}>
  <!-- Hero -->
  <Hero />

  <!-- Credibility strip -->
  <CredibilityStrip />

  <!-- Stats -->
  <section class="pb-16">
    <StatCounter stats={stats} />
  </section>

  <!-- B2 explorer mounts here (id kept live so the hero teaser CTA lands) -->
  <div id="explorer"></div>

  <!-- Featured Projects -->
  <ProjectBench projects={projects} />

  <!-- Competencies -->
  <CompetencyGrid />

  <!-- About Preview -->
  <section class="py-16">
    <h2 class="text-3xl font-semibold mb-4">About</h2>
    <p class="text-[var(--color-text-secondary)] max-w-[55ch] leading-relaxed">
      Two things rarely sit in one person: a business head and frontier-AI hands.
      I have both. I take AI that mostly lives in demos and turn it into systems
      that run inside a real business, knowledge engines, automations, and agents.
      The business lens is what makes the technology useful.
    </p>
    <p class="mt-4">
      <a href="/about" class="text-sm font-medium">Read more &rarr;</a>
    </p>
  </section>
</BaseLayout>
