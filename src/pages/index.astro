---
import BaseLayout from "../layouts/BaseLayout.astro";
import ImpactStats from "../components/ImpactStats.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { SITE, PERSON } from "../lib/constants";
import { generatePersonSchema } from "../schemas/person";
import { generateWebSiteSchema } from "../schemas/website";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const stats = [
  { number: "70+", label: "knowledge domains running on a system I built and use daily" },
  { number: "483", label: "automation workflows across 8 domains" },
  { number: "1 weekend", label: "to produce a full priced tender package a team scopes in weeks" },
];

const schemas = [generateWebSiteSchema(), generatePersonSchema()];
---

<BaseLayout title={SITE.name} description={SITE.description} schemaJsonLd={schemas}>
  <!-- Hero -->
  <section class="py-24">
    <h1 class="text-5xl font-bold">{PERSON.name}</h1>
    <p class="text-xl text-[var(--color-text-secondary)] mt-3">{PERSON.jobTitle}</p>
    <p class="text-lg text-[var(--color-text-secondary)] mt-4 max-w-[55ch] leading-relaxed">
      I build AI systems that give organizations leverage they do not have yet.
      Frontier tools made to actually run inside a business, not just demo.
      I come at it from business, not computer science, and that is what makes
      it useful. Based in Toronto.
    </p>
    <ImpactStats stats={stats} />
  </section>

  <!-- Featured Projects -->
  <section class="py-16">
    <h2 class="text-3xl font-semibold mb-8">Projects</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          description={project.data.description}
          domain={project.data.domain}
          metric={{ value: project.data.metrics[0].value, label: project.data.metrics[0].label }}
          technologies={project.data.technologies.slice(0, 4)}
        />
      ))}
    </div>
    <p class="mt-6">
      <a href="/projects" class="text-sm font-medium">View all projects &rarr;</a>
    </p>
  </section>

  <!-- About Preview -->
  <section class="py-16">
    <h2 class="text-3xl font-semibold mb-4">About</h2>
    <p class="text-[var(--color-text-secondary)] max-w-[55ch] leading-relaxed">
      Two things rarely sit in one person: a business head and frontier-AI hands.
      I have both. I take AI that mostly lives in demos and turn it into systems
      that run inside a real business, knowledge engines, automations, and agents.
      The business lens is what makes the technology useful.
    </p>
    <p class="mt-4">
      <a href="/about" class="text-sm font-medium">Read more &rarr;</a>
    </p>
  </section>
</BaseLayout>
