---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { PROJECT_CARD_IMAGES } from "../../lib/constants";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout title="Projects" description="AI systems built to run inside real businesses: knowledge engines, automations, and agents." markdownUrl="/projects/index.md">
  <Breadcrumbs items={[{ label: "Projects", href: "/projects" }]} />
  <h1 class="pi-title">Work that <em>runs</em><span class="pi-dot" aria-hidden="true"></span></h1>
  <p class="pi-lede">
    AI systems built to run inside real businesses: knowledge engines, automations,
    and agents. Each one ends in an outcome, not a demo.
  </p>
  <h2 class="sr-only">All projects</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-12 mb-24">
    {projects.map((project) => (
      <ProjectCard
        slug={project.id}
        title={project.data.title}
        description={project.data.description}
        domain={project.data.domain}
        status={project.data.status}
        philosophy={project.data.philosophy}
        metric={{ value: project.data.metrics[0].value, label: project.data.metrics[0].label }}
        technologies={project.data.technologies.slice(0, 4)}
        image={PROJECT_CARD_IMAGES[project.id]}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .pi-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 520;
    letter-spacing: -0.015em;
    margin: var(--spacing-8) 0 var(--spacing-6);
  }

  .pi-title em {
    font-style: italic;
    font-weight: 480;
    color: var(--color-accent);
  }

  .pi-dot {
    display: inline-block;
    width: 0.13em;
    height: 0.13em;
    border-radius: 999px;
    background-color: var(--color-accent);
    margin-left: 0.08em;
  }

  .pi-lede {
    max-width: 55ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }
</style>
